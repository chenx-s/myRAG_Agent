# ---------------------------------------------------------------- 密钥
# .env 里有真实 API Key，绝对不要提交
.env

# ---------------------------------------------------------------- 生成的向量库
# Milvus 本地库 + BM25 语料副本都是可再生的，不入库
/vector_db/*
!/vector_db/.gitkeep

# 上传的原始文档（可能很大）
/data/uploads/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---------------------------------------------------------------- 虚拟环境
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------- IDE / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 运行产物
# RAGAs 评估报告
eval_report.csv
eval_report.json
# 自己写的评估集（如果不想共享）
# eval_set.json

*.log

# ---------------------------------------------------------------- 模型缓存
# HuggingFace 下载的 Embedding 模型默认落在用户目录，一般不会出现在这里；
# 但如果设了 HF_HOME=./models，就会被这个规则挡住
/models/
