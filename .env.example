# ================================================================
# RAG_mine 环境配置
# 注意：路径都是相对「项目根目录」的，请在 D:\project\llm\RAG_mine 下启动服务
# ================================================================

# ---------------------------------------------------------------- LLM（智谱 GLM，OpenAI 兼容协议）
LLM_MODEL=glm-4.5-air
LLM_API_KEY=请填写你的智谱APIKey
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------- Redis / LLM 响应缓存
# 启动 Redis 示例：docker run -d --name rag-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_ENABLED=true
# 0 表示永不过期；生产环境建议设置合理 TTL，避免陈旧答案长期保留
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_PREFIX=rag:llm-cache:v1
# Redis 不可用时快速旁路，LLM 请求仍会正常执行
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
# 连接失败后暂时停止访问 Redis，防止一次请求中的多个 LLM 节点反复超时
LLM_CACHE_FAILURE_COOLDOWN_SECONDS=30

# RAGAs 等第三方库会直接读 OPENAI_API_KEY / OPENAI_BASE_URL，这里指向同一个智谱端点
OPENAI_API_KEY=请填写你的智谱APIKey（同 LLM_API_KEY）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 阿里云百炼（备用模型，当前代码未使用）
ALI_BASE_URL=https://ws-1ofh66f2687cvsqr.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_API_KEY=请填写（当前代码未使用，可留空）

GEMINI_API_KEY=请填写（当前代码未使用，可留空）

# ---------------------------------------------------------------- Embedding（本地，不走 API）
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- 向量库（Milvus）
# 【重要】变量名必须是 RAG_MILVUS_URI，不能写成 MILVUS_URI！
# pymilvus 3.x 会在 import 阶段读取环境变量 MILVUS_URI 并强制按 http[s]:// 解析，
# 值若是本地文件路径会让 import pymilvus 直接抛 ConnectionConfigException。
RAG_MILVUS_URI=./vector_db/milvus_rag.db
# 远程 Milvus / Zilliz Cloud 鉴权用，本地文件模式留空
MILVUS_TOKEN=
# 只有换了 Embedding 模型、向量维度变了才临时改成 true；改完立刻改回 false，
# 否则每次重启都会清空知识库
MILVUS_DROP_OLD=false

VECTOR_DB_PATH=./vector_db
INDEX_NAME=rag_index
BM25_CORPUS_FILE=bm25_corpus.jsonl

# ---------------------------------------------------------------- 检索超参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ---------------------------------------------------------------- 混合检索 Hybrid Search
HYBRID_ENABLED=true
# 稠密(向量)/稀疏(BM25) 在 RRF 融合时的权重。
# 专有名词、型号、编号多的知识库 -> 调高 SPARSE_WEIGHT
# 口语化、语义化提问多 -> 调高 DENSE_WEIGHT
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
DENSE_TOP_K=20
SPARSE_TOP_K=20
# 融合后的候选数，也就是送给 Reranker 的条数
FUSION_TOP_K=20

# ---------------------------------------------------------------- 查询变换
# none / multi_query(RAG-Fusion) / hyde
QUERY_TRANSFORM=multi_query
NUM_QUERIES=3

# ---------------------------------------------------------------- 精排 Reranker
RERANK_ENABLED=true
RERANK_PROVIDER=cohere
COHERE_API_KEY=请填写你的CohereAPIKey  # https://dashboard.cohere.com/api-keys
COHERE_RERANK_MODEL=rerank-v3.5
# 精排后最终喂给 LLM 的文档块数
RERANK_TOP_N=5

# ---------------------------------------------------------------- Agentic RAG
# 最大「检索-评分-改写」循环轮数
MAX_RETRIES=2
# LangGraph 单次调用最大步数，必须大于 2*(MAX_RETRIES+1)+3
RECURSION_LIMIT=25

# ---------------------------------------------------------------- 数据目录
DATA_DIR=./data

# ---------------------------------------------------------------- 可选的文档解析服务
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
UNSTRUCTURED_API_KEY=请填写（当前代码未使用，可留空）

# ---------------------------------------------------------------- LangSmith 追踪（可选）
# 保持你原来的设置（开启）。不想追踪就改成 false，
# 能省下每条链路的额外网络开销，调试期再打开。
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=请填写（不用LangSmith可留空）
LANGSMITH_PROJECT=MyFirstProject
